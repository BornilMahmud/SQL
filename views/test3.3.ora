
CREATE TABLE employees (
  emp_id INTEGER PRIMARY KEY,
  emp_name TEXT,
  salary REAL,
  dept_id INTEGER
);
INSERT INTO employees VALUES (1, 'Alice', 75000, 101);
INSERT INTO employees VALUES (2, 'Bob', 60000, 102);
INSERT INTO employees VALUES (3, 'Carol', 85000, 101);
INSERT INTO employees VALUES (4, 'David', 50000, 103);

CREATE TABLE departments (
  dept_id INTEGER PRIMARY KEY,
  dept_name TEXT
);

INSERT INTO departments VALUES (101, 'Engineering');
INSERT INTO departments VALUES (102, 'Marketing');
INSERT INTO departments VALUES (103, 'HR');

CREATE TABLE locations (
  dept_id INTEGER,
  location TEXT
);
INSERT INTO locations VALUES (101, 'New York');
INSERT INTO locations VALUES (102, 'London');
INSERT INTO locations VALUES (103, 'Tokyo');

CREATE TABLE projects (
  project_id INTEGER,
  emp_id INTEGER,
  project_name TEXT
);
INSERT INTO projects VALUES (1, 1, 'AI System');
INSERT INTO projects VALUES (2, 2, 'Marketing Campaign');
INSERT INTO projects VALUES (3, 3, 'Backend API');
INSERT INTO projects VALUES (4, 4, 'HR Portal');



CREATE VIEW dept_avg_salary_location AS
SELECT 
  d.dept_name,
  l.location,
  AVG(e.salary) AS avg_salary
FROM employees e
JOIN departments d ON e.dept_id = d.dept_id
JOIN locations l ON e.dept_id = l.dept_id
GROUP BY d.dept_name, l.location;

CREATE VIEW employee_count_per_dept AS
SELECT 
  d.dept_name,
  COUNT(e.emp_id) AS total_employees
FROM employees e
JOIN departments d ON e.dept_id = d.dept_id
GROUP BY d.dept_name;

select * from employee_count_per_dept;

select * from dept_avg_salary_location ;